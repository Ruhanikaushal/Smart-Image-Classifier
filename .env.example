# =====================================================================
# Environment Configuration Template for Local & Render Deployment
# =====================================================================
# Rename this file to .env for local testing.
# On Render: Add these variables under Dashboard -> Environment -> Environment Variables.

# Server & Network Configuration
# Render automatically injects the PORT environment variable at runtime.
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# Application Settings
ENVIRONMENT=production
MODEL_PATH=best_plant_model.pth
CLASSES_PATH=classes.json

# Optional Performance Flags
TORCH_NUM_THREADS=2
OMP_NUM_THREADS=2
