# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-code / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/

# Environment variables & secrets (Never commit secrets!)
.env
.env.*
!.env.example

# Streamlit local configurations & secrets
.streamlit/secrets.toml

# IDEs & Editor configurations
.vscode/
.idea/
*.swp
*.swo

# Operating System temporary files
.DS_Store
Thumbs.db
desktop.ini

# Logs & runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*

# Model checkpoints (Track our trained model specifically, ignore ad-hoc checkpoints)
*.ckpt
*.h5
# Explicitly keep our trained model checkpoint tracked for Render deployment
!best_plant_model.pth

# Interview / Viva Guides (Internal only, not for repository)
